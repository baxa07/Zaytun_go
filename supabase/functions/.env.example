# Secret/config NAMES only -- never real values, never the historical exposed
# credential, never its replacement, never a production URL. Copy this file to
# supabase/functions/.env locally (git-ignored) and fill in values there. In
# production, SEND_SMS_HOOK_SECRETS/ESKIZ_* are set as Supabase Edge Function
# secrets (Dashboard or `supabase secrets set`), never committed anywhere.
SEND_SMS_HOOK_SECRETS=
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_SENDER=

# SEND_SMS_HOOK_URI resolves supabase/config.toml's
# [auth.hook.send_sms].uri -- read by the Supabase CLI itself (must be set in
# the shell environment before `supabase start`/`stop`/`db reset`, not just
# in this file), never by the Edge Function's own runtime. Locally this
# should be the local Edge Runtime URL:
#   http://host.docker.internal:54321/functions/v1/send-sms-hook
# NEVER put the production function URL here or anywhere in tracked source --
# see docs/production-readiness.md's config-push safety note before this is
# ever set for a real/linked project.
SEND_SMS_HOOK_URI=
